[Unit]
Description=Hermes Native Goal Runner - Autonomous goal execution controller
Documentation=https://github.com/director-phil/hermes-mission-control

[Service]
Type=simple
ExecStart=/usr/bin/env python3 %h/Documents/GitHub/hermes-mission-control/scripts/hermes_native_goal_runner.py
Restart=on-failure
RestartSec=5
Environment=HERMES_LANGFUSE_CAPTURE_CONTENT=false
Environment=HERMES_LANGFUSE_CAPTURE_TOOL_IO=false
Environment=HERMES_NATIVE_ALLOWED_WORKTREE_ROOTS=%h/.hermes/mission-control-worktrees

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/Documents/GitHub
ReadWritePaths=%h/.hermes/mission-control/runtime
ReadWritePaths=%h/.hermes/mission-control-worktrees
PrivateTmp=yes

[Install]
WantedBy=default.target
